{
  "name": "decentraland-social-arcade",
  "version": "0.1.0",
  "private": true,
  "description": "Escena social de Decentraland, preparada para crecer desde un juego insignia hacia un catálogo modular.",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "start": "sdk-commands start",
    "build": "sdk-commands build",
    "deploy": "sdk-commands deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "docs:check": "node scripts/check-docs.mjs",
    "repo:check": "node scripts/validate-repository.mjs",
    "check": "pnpm repo:check && pnpm docs:check && pnpm lint && pnpm typecheck && pnpm test && pnpm format:check"
  },
  "dependencies": {
    "@dcl/sdk": "7.27.0"
  },
  "devDependencies": {
    "@dcl/sdk-commands": "7.27.0",
    "@eslint/js": "9.35.0",
    "ajv": "8.17.1",
    "eslint": "9.35.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "tslib": "2.8.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
